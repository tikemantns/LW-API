{
  "name": "lw-api",
  "version": "1.0.0",
  "description": "A Node.js TypeScript project for managing LW.",
  "main": "server.ts",
  "scripts": {
    "build": "tsc",
    "dev": "env-cmd -f .env.local nodemon server.ts",
    "nonprod": "env-cmd -f .env.nonprod ts-node server.ts",
    "start:dev": "node dist/server.js",
    "start:nonprod": "node dist/server.js",
    "start:prod": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.ts\" \"tests/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:sns": "env-cmd -f .env.example ts-node scripts/test-sns-events.ts",
    "test:redis": "env-cmd -f .env.example ts-node scripts/test-redis-connection.ts",
    "test:cache": "env-cmd -f .env.example ts-node scripts/test-cache-service.ts",
    "security": "npm audit --audit-level=high",
    "analyze": "npx snyk test",
    "prestart": "npm run security",
    "performance": "NODE_ENV=production node --expose-gc dist/server.js"
  },
  "dependencies": {
    "aws-sdk": "^2.1692.0",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "env-cmd": "^10.1.0",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.6.1",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "mongodb": "^6.17.0",
    "mongoose": "^7.4.0",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "redis": "^5.5.6",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/hpp": "^0.2.6",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.4.5",
    "@types/node-cache": "^4.2.5",
    "@types/redis": "^4.0.11",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "axios": "^1.10.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-security": "^2.1.1",
    "jest": "^29.6.1",
    "mongodb-memory-server": "^10.1.4",
    "prettier": "^3.6.2",
    "snyk": "^1.1279.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "node",
    "typescript",
    "express",
    "swagger",
    "mongoose"
  ],
  "author": "Your Name",
  "license": "MIT"
}
