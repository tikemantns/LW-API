#mongodb://username:password@host:port/dbname?ssl=true&retryWrites=false
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=5
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=15000
MONGODB_HEARTBEAT_FREQUENCY_MS=10000
USE_ESTIMATED_COUNT=false

# API Configuration
API_VERSION=v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Authentication (Development only)
# IMPORTANT: Generate a strong secret key for production
JWT_SECRET=your_jwt_secret_key_should_be_very_long_and_secure_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION=24h
ENFORCE_REQUEST_SIGNING=false
